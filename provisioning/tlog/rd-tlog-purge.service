[Unit]
Description=purge rd-tlog transcripts past retention
RequiresMountsFor=/var/lib/rd-tlog

[Service]
Type=oneshot
ExecStartPre=/usr/local/lib/rd-tlog/check-store.sh
# shell wrapper is required for the env-default expansion
ExecStart=/bin/sh -c 'find /var/lib/rd-tlog/sessions -type f -mtime +${RD_TLOG_RETENTION_DAYS:-60} -delete'
