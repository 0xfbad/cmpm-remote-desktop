[Unit]
Description=rd-tlog collector (per-session terminal transcripts)
Requires=rd-tlog-collector.socket
After=rd-tlog-collector.socket

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/rd-tlog/rd_tlog_collector.py
Restart=always
RestartSec=2
StateDirectory=rd-tlog
NoNewPrivileges=yes
# connect() to /var/run/docker.sock works on a read-only mount - connecting is
# not a mount-level write
ProtectSystem=strict
ReadWritePaths=/var/lib/rd-tlog
Environment=RD_TLOG_PER_SESSION_MAX=1073741824
Environment=RD_TLOG_TOTAL_MAX=42949672960

[Install]
WantedBy=multi-user.target
