[Unit]
Description=Disable IPv6 on remote-desktop pool bridges (rdb*)
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for f in /proc/sys/net/ipv6/conf/rdb*/disable_ipv6; do [ -e "$f" ] || continue; echo 1 > "$f"; done'

[Install]
WantedBy=multi-user.target
