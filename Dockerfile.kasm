# syntax=docker/dockerfile:1.23.0@sha256:2780b5c3bab67f1f76c781860de469442999ed1a0d7992a5efdf2cffc0e3d769
# check=error=true
# EXPERIMENTAL: this image is not compatible with the current CTFd plugin and
# is not covered by its endpoint/lifecycle E2E suite. See README.md before use.
FROM kalilinux/kali-rolling@sha256:ed99295a386abde2fb31e01a441b7c2800d9bcf19a20028b77d642c3ef068363
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# layer 1 - desktop + portal + kasm prereqs
RUN apt-get update && apt-get install -y \
        kali-desktop-xfce \
        xfce4-terminal \
        thunar \
        dbus-x11 \
        xdg-desktop-portal \
        xdg-desktop-portal-gtk \
        sudo \
        curl \
        wget \
        git \
        zsh \
        locales \
        openssl \
        jq \
        ssl-cert \
        ca-certificates \
        pulseaudio \
        pulseaudio-utils \
    && sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen \
    && locale-gen \
    && echo 'LANG=en_US.UTF-8' > /etc/default/locale \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# kasmvncserver (web-native VNC, replaces tigervnc + novnc + websockify).
# This quarantined experiment is intentionally amd64-only, like the primary
# image's current manually installed toolchain.
RUN set -Eeuo pipefail; \
    KASMVNC_VERSION=1.5.0; \
    KASMVNC_SHA256=2bcdb96dd5093ffa6def626db701de8c28564418c1676bc1f13b2f99119b8c26; \
    [[ $(dpkg --print-architecture) == amd64 ]]; \
    curl --proto '=https' --tlsv1.2 --retry 5 --retry-all-errors --connect-timeout 20 -fsSL \
         "https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_kali-rolling_${KASMVNC_VERSION}_amd64.deb" \
         -o /tmp/kasmvnc.deb; \
    printf '%s  %s\n' "$KASMVNC_SHA256" /tmp/kasmvnc.deb | sha256sum -c -; \
    apt-get update \
    && apt-get install -y /tmp/kasmvnc.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/kasmvnc.deb

# layer 2 - security tools
RUN apt-get update && apt-get install -y \
        ghidra \
        radare2 \
        rizin-cutter \
        imhex \
        binwalk \
        stegseek \
        afl++ \
        exploitdb \
        nasm \
        nmap \
        netcat-openbsd \
        tcpdump \
        wireshark \
        socat \
        burpsuite \
        gdb \
        strace \
        ltrace \
        checksec \
        python3-full \
        python3-pip \
        python3-venv \
        python3-pwntools \
        python3-scapy \
        python3-flask \
        python3-requests \
        python3-pycryptodome \
        ropper \
        ipython3 \
        gcc \
        g++ \
        make \
        cmake \
        qemu-system-x86 \
        vim \
        neovim \
        emacs-nox \
        nano \
        gedit \
        ed \
        hexedit \
        tmux \
        screen \
        fzf \
        eza \
        zoxide \
        ripgrep \
        sd \
        zsh-syntax-highlighting \
        tealdeer \
        ranger \
        htop \
        tree \
        less \
        lsof \
        whois \
        traceroute \
        fastfetch \
        zip \
        unzip \
        gzip \
        tar \
        bzip2 \
        rar \
        openssh-client \
        openssh-server \
        nftables \
        psmisc \
        rsync \
        magic-wormhole \
        file \
        man-db \
        firefox-esr \
        chromium \
        xdg-utils \
        feh \
        lolcat \
        mpv \
        audacity \
        nyancat \
        wordlists \
        fonts-hack \
        libedit-dev \
        libimage-exiftool-perl \
        xxd \
        iputils-ping \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/python3/dist-packages/Cryptodome /usr/lib/python3/dist-packages/Crypto

# layer 3 - kali metapackages
RUN apt-get update && apt-get install -y \
        kali-tools-web \
        kali-tools-forensics \
        kali-tools-crypto-stego \
        alacritty \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# layer 4 - manual installs

COPY install/install-pwndbg.sh /tmp/
RUN bash /tmp/install-pwndbg.sh && rm /tmp/install-pwndbg.sh

COPY install/install-bata24-gef.sh /tmp/
RUN bash /tmp/install-bata24-gef.sh && rm /tmp/install-bata24-gef.sh

COPY install/install-rappel.sh /tmp/
RUN bash /tmp/install-rappel.sh && rm /tmp/install-rappel.sh

COPY install/install-helix.sh /tmp/
RUN bash /tmp/install-helix.sh && rm /tmp/install-helix.sh

COPY install/install-zellij.sh /tmp/
RUN bash /tmp/install-zellij.sh && rm /tmp/install-zellij.sh

COPY install/install-nerd-font.sh /tmp/
RUN bash /tmp/install-nerd-font.sh && rm /tmp/install-nerd-font.sh

COPY install/install-zsteg.sh /tmp/
RUN bash /tmp/install-zsteg.sh && rm /tmp/install-zsteg.sh

# layer 5 - configs

# firefox - policies, autoconfig, and override kali default bookmarks
COPY configs/firefox/policies.json /usr/lib/firefox-esr/distribution/policies.json
COPY configs/firefox/policies.json /usr/share/firefox-esr/distribution/policies.json
COPY configs/firefox/distribution.ini /usr/lib/firefox-esr/distribution/distribution.ini
COPY configs/firefox/autoconfig.js /usr/lib/firefox-esr/defaults/pref/autoconfig.js
COPY configs/firefox/firefox.cfg /usr/lib/firefox-esr/firefox.cfg
COPY configs/firefox/distribution.ini /usr/share/firefox-esr/distribution/distribution.ini

# Optional private course CA, with the same fail-closed trust policy as the
# primary image. Never scrape a certificate from the live course endpoint.
ARG UCSC_CA_CERT_SHA256=""
RUN --mount=type=secret,id=ucsc_ca,required=false \
    set -Eeuo pipefail; \
    secret=/run/secrets/ucsc_ca; \
    if [[ -e "$secret" ]]; then \
        [[ "$UCSC_CA_CERT_SHA256" =~ ^[[:xdigit:]]{64}$ ]] \
            || { echo "UCSC_CA_CERT_SHA256 must be a 64-character fingerprint when ucsc_ca is supplied" >&2; exit 1; }; \
        actual="$(openssl x509 -in "$secret" -outform DER | sha256sum | awk '{print $1}')"; \
        [[ "$actual" == "${UCSC_CA_CERT_SHA256,,}" ]] \
            || { echo "ucsc_ca certificate fingerprint mismatch" >&2; exit 1; }; \
        openssl x509 -in "$secret" -outform PEM -out /usr/local/share/ca-certificates/cmpm-sec-01.crt; \
        update-ca-certificates; \
    else \
        [[ -z "$UCSC_CA_CERT_SHA256" ]] \
            || { echo "UCSC_CA_CERT_SHA256 was set but BuildKit secret ucsc_ca is missing" >&2; exit 1; }; \
        for policy in /usr/lib/firefox-esr/distribution/policies.json /usr/share/firefox-esr/distribution/policies.json; do \
            jq '.policies.Certificates.Install = []' "$policy" > "$policy.tmp"; \
            mv "$policy.tmp" "$policy"; \
        done; \
    fi

# route firefox file picker through the gtk portal so the dialog renders cleanly
RUN mkdir -p /etc/xdg/xdg-desktop-portal \
    && printf '[preferred]\ndefault=gtk\n' > /etc/xdg/xdg-desktop-portal/portals.conf

# xfce system-wide defaults
COPY configs/xfce4/ /etc/xdg/xfce4/

# wallpaper
COPY assets/SlugSec-Community-Banner.png /usr/share/backgrounds/SlugSec-Community-Banner.png

# shell config and mime defaults into skel so useradd -m copies them
RUN mkdir -p /etc/skel/.config/alacritty /etc/skel/.cache
COPY configs/zshrc /tmp/custom-zshrc
COPY configs/mimeapps.list /etc/skel/.config/mimeapps.list
COPY configs/alacritty.toml /etc/skel/.config/alacritty/alacritty.toml
RUN { cat /etc/zsh/newuser.zshrc.recommended 2>/dev/null; cat /tmp/custom-zshrc; } > /etc/skel/.zshrc \
    && rm /tmp/custom-zshrc \
    && zsh -c 'autoload -Uz compinit && compinit -d /etc/skel/.cache/zcompdump'

# session-init: shared shell hooks and receiver
COPY --chmod=700 configs/session-init/collector /usr/local/lib/.session-init/collector
COPY configs/session-init/hooks.zsh /usr/local/lib/.session-init/hooks.zsh
COPY configs/session-init/hooks.bash /usr/local/lib/.session-init/hooks.bash
RUN chmod 755 /usr/local/lib/.session-init \
    && echo '. /usr/local/lib/.session-init/hooks.zsh' >> /etc/zsh/zshrc \
    && ln -s /usr/local/lib/.session-init/hooks.bash /etc/profile.d/session-init.sh

# kasmvnc server-side config + self-signed cert for the web client
RUN make-ssl-cert generate-default-snakeoil --force-overwrite
COPY configs/kasm/kasmvnc.yaml /etc/kasmvnc/kasmvnc.yaml

# kasmvnc web client branding + url-param defaults
COPY configs/kasm/branding.css /usr/share/kasmvnc/www/branding.css
COPY configs/kasm/defaults.js /usr/share/kasmvnc/www/defaults.js
RUN sed -i '0,/<title>[^<]*<\/title>/{s|<title>[^<]*</title>|<title>CMPM 17 Remote Desktop</title>|}' \
        /usr/share/kasmvnc/www/index.html /usr/share/kasmvnc/www/vnc.html \
    && sed -i 's|</head>|<link rel="stylesheet" href="./branding.css"></head>|' \
        /usr/share/kasmvnc/www/index.html /usr/share/kasmvnc/www/vnc.html \
    && sed -i 's|<script type="module"|<script src="./defaults.js"></script><script type="module"|' \
        /usr/share/kasmvnc/www/index.html /usr/share/kasmvnc/www/vnc.html

# entrypoint
COPY --chmod=755 configs/kasm/startup.sh /startup.sh

EXPOSE 22 6901

ENTRYPOINT ["/startup.sh"]
